# Copy to .env and fill in. Used by docker compose.

# Signs login tokens. At least 32 characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=

# The admin account created on first start. Password: at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Set to true to add the sample users (they get the admin password).
SEED_SAMPLE_USERS=false

# The address other machines use to reach this one. Leave empty and
# ./start.sh finds this machine's IP on the network.
PUBLIC_HOST=

# Ports on this machine.
API_PORT=18067
CLIENT_PORT=8067
